{
  "schemaVersion": 1,
  "id": "resourcepackplus",
  "version": "${version}",
  "name": "Server Packs+",
  "description": "Skip, cache, convert, and manage server resource packs (e.g. Hypixel Skyblock's) — keep them applied, or turn them into regular editable local packs.",
  "authors": [
    "GamingLegend123",
    "Claude Opus 4.8"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/resourcepackplus/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.rpplus.resourcepackplus.ResourcePackPlusClient"
    ],
    "modmenu": [
      "com.rpplus.resourcepackplus.compat.ModMenuIntegration"
    ]
  },
  "mixins": [
    "resourcepackplus.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
